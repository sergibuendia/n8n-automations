    {
      "parameters": {
        "jsCode": "const hoy = new Date();\nconst dosSemanasAntes = new Date();\ndosSemanasAntes.setDate(hoy.getDate() - 14); // ⬅️ 14 días = 2 semanas\n\nreturn items.filter(item => {\n  const stage = (item.json.Stage || \"\").toLowerCase().trim();\n  const fechaRaw = item.json['Last interacted on'];\n\n  // Verificamos que haya valor en la fecha\n  if (!fechaRaw) return false;\n\n  // Extraer fecha del formato DD/MM/YYYY, HH:mm:ss\n  const [dia, mes, anio] = fechaRaw.split(',')[0].trim().split('/');\n  const fechaUltimoContacto = new Date(`${anio}-${mes}-${dia}`);\n\n  const esSinRespuesta = stage === 'contactadas sin respuesta';\n  const haceMasDe2Semanas = fechaUltimoContacto < dosSemanasAntes;\n\n  return esSinRespuesta && haceMasDe2Semanas;\n});\n"
      },
